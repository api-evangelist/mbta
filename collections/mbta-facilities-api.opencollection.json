{
  "opencollection": "1.0.0",
  "info": {
    "name": "MBTA V3 Alerts Facilities API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Facilities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List facilities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-v3.mbta.com/facilities",
            "params": [
              {
                "name": "page[offset]",
                "value": "",
                "type": "query",
                "description": "Offset (0-based) into the collection."
              },
              {
                "name": "page[limit]",
                "value": "",
                "type": "query",
                "description": "Maximum number of resources to return."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to sort by. Prepend '-' for descending."
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of relationships to include."
              }
            ]
          },
          "docs": "Returns stop amenities such as elevators and bike racks."
        },
        {
          "info": {
            "name": "Get facility",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-v3.mbta.com/facilities/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get facility"
        }
      ]
    }
  ],
  "bundled": true
}